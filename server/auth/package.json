    "cors": "2.8.6",
    "express": "4.22.2",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "multer": "1.4.5-lts.2",
    "nodemailer": "9.0.5",
    "pdfkit": "0.20.2",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "pino-pretty": "11.3.0",
    "prom-client": "15.1.3",
    "sharp": "0.35.3",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
