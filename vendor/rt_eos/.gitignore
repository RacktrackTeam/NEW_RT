# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Python virtualenv (regenerable; holds large binaries)
.venv/
venv/

# Model weights - distributed separately, not version-controlled
*.pt
*.pth
*.onnx
Models/
Models.zip
# ONNX fp32 sources - re-derivable from the .pt files
Models/exported/

# Build artifacts
client/dist/
client/build/

# Native mobile build output - regenerable, never commit
client/ios/App/build/
client/ios/App/build_sim/
client/ios/App/DerivedData/
client/android/app/build/
client/android/build/
client/android/.gradle/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/

# The data tree: databases, every scan, matrix and cache (server/lib/store.js).
# Holds password hashes and customer photos. Never commit.
/data/

# Environment: <repo>/.env is the one secrets file (keys in .env.example)
.env
.env.*
!.env.example
server/.env
client/.env.production
client/.firebase-app-id

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Signing key material. JWT_SECRET lives in .env; the generated fallback key
# and the mail token cache live in the data folder. Never commit.
*.secret
*.jks
*.keystore
*.p12
*.mobileprovision
*.p8
AuthKey_*.p8

# Scratch test artifacts at repo root (one-shot captures, leading dot)
/.benchmark_*.png
/.full_pipeline_*.png
/.test_rack_*.jpg
/.test_response.json

# Raw video takes dropped at the repo root while picking footage.
/*.mp4

# Word lock files (created when a .docx is open in Microsoft Word).
~$*.docx

# Vitest coverage output - regenerated by `npm test -- --coverage`, never shipped.
client/coverage/

# Old secret folders from before the one .env file. Kept ignored in case a
# copy is ever dropped back in.
token/
.secrets/

switch_specs/*.db
__pycache__/

# Photo sets for local checks (the seven cable-flag test photos, the data-centre racks): kept on disk, never in git.
/samples/
