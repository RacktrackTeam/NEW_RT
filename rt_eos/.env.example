# RT-EOS settings. Copy to .env at the repo root and fill in what you need.
# .env is the one secrets file: the server loads it on start
# (server/lib/load_env.js) and vite reads its VITE_* keys. Never commit .env.
# One KEY=VALUE per line; comments on their own line only. A value already in
# the real environment wins over the file. Empty or missing keys use the
# default the code gives them.

# ── Sessions ────────────────────────────────────────────────────────────
# Signs every session token. Unset: a key is generated once into the data folder.
JWT_SECRET=
# Password hash cost (default 12).
BCRYPT_COST=
# Lifetime of a native-app bearer token (default 30d).
TOKEN_TTL=
# Lifetime of the web access cookie (default 15m).
ACCESS_TOKEN_EXPIRY=
# Lifetime of the web refresh cookie (default 30d).
REFRESH_TOKEN_EXPIRY=
# How long a just-rotated refresh token is still accepted, in ms (default 5000).
REFRESH_REUSE_GRACE_MS=
# Cookie domain, only when the API and web app sit on different subdomains.
COOKIE_DOMAIN=
# true or false; unset means on in production, off elsewhere.
COOKIE_SECURE=
# lax (same origin) or none (different sites, needs secure).
COOKIE_SAMESITE=
# Comma-separated usernames allowed to read the whole audit log.
AUDIT_ADMINS=

# ── Server ──────────────────────────────────────────────────────────────
# production locks CORS and hides error details.
NODE_ENV=
# HTTP port (default 3001).
PORT=
# Comma-separated web origins allowed to call the API.
CORS_ALLOWED_ORIGINS=
# How long running scans get to finish on shutdown, in ms (default 30000).
SHUTDOWN_TIMEOUT_MS=

# ── Data folder ─────────────────────────────────────────────────────────
# The auth database (default data/db/auth.db). It decides the whole data tree:
# the other database files sit beside it, and orgs/ and cache/ sit one level up
# when its folder is named db (server/lib/data_paths.js, server/lib/store.js).
RACKTRACK_AUTH_DB=
# The request log database on its own (':memory:' keeps it in memory).
LOG_DB_PATH=
# Log level: trace, debug, info, warn, error (default info).
LOG_LEVEL=
# Days of request log kept.
LOG_RETENTION_DAYS=
# Most request log rows kept (default 200000).
LOG_MAX_ROWS=
# Days an unowned scan is kept before the daily clean-up counts it.
ORPHAN_GC_RETENTION_DAYS=
# 1 lets the daily clean-up delete unowned scan folders (default report only).
ORPHAN_GC_APPLY=

# ── Upload limits ───────────────────────────────────────────────────────
# Uploads per minute per user, and the burst allowed above it.
RATE_LIMIT_UPLOADS_PER_MIN=
RATE_LIMIT_BURST=
# Detection runs per minute per user, and the burst allowed above it.
RATE_LIMIT_DETECT_PER_MIN=
RATE_LIMIT_DETECT_BURST=

# ── Scan engine (Python) ────────────────────────────────────────────────
# Python interpreter (default .venv/bin/python, else python3).
PYTHON_PATH=
# Number of scan workers; each holds every model in memory. Unset: 2 when the
# machine has 8 GB or more of free memory when the server starts, else 1.
RACKTRACK_WORKERS=
# Longest one scan request may take, in ms.
RACKTRACK_WORKER_TIMEOUT_MS=
# Pipeline config file (default config.json).
RACKTRACK_CONFIG=
# Rack occlusion classifier weights, and its confidence cut-off (default 0.55).
RACK_CLASSIFIER_PATH=
RACK_CLASSIFIER_HARD_CONF=

# ── Mail: Microsoft Graph, sent from support@racktrack.ai ───────────────
# Microsoft 365 tenant of the sender mailbox.
MS_TENANT_ID=
# Azure app id; with MS_CLIENT_SECRET enables app-only sending.
MS_CLIENT_ID=
# Azure app secret for app-only sending (Mail.Send application permission).
MS_CLIENT_SECRET=
# Delegated refresh token of the support mailbox.
MS_REFRESH_TOKEN_SUPPORT=
# Azure app id that issued MS_REFRESH_TOKEN_SUPPORT (default MS_CLIENT_ID).
MS_REFRESH_CLIENT_ID_SUPPORT=
# Override the sender address (default support@racktrack.ai).
MAIL_FROM_SUPPORT=

# ── Mail: SMTP fallback, used when Graph cannot send ────────────────────
# Primary SMTP account (host default smtp.gmail.com, port default 465).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Second SMTP account, tried after the primary.
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
SMTP_FALLBACK_FROM=

# ── Social sign-in (a provider without keys is simply hidden) ───────────
# Public https base the providers redirect back to.
OAUTH_REDIRECT_BASE=
# Web app origin to return to after sign-in (default OAUTH_REDIRECT_BASE).
OAUTH_WEB_ORIGIN=
# URL scheme the native app registers (default com.racktrack.app).
OAUTH_NATIVE_SCHEME=
# Google OAuth client.
# Apple Sign in: service id, team, key id, and the .p8 key inline (\n escaped) or by path.
# Facebook app; FACEBOOK_TRUST_EMAIL=1 trusts its email for account linking.

# ── Client build (vite reads these; they end up in the public bundle) ───
# API origin for a different-host build. Leave empty for the web build; the
# phone build takes it from the shell: VITE_API_BASE=https://... npm run build:mobile
VITE_API_BASE=
# App key header sent with every API call.
VITE_APP_KEY=
# 1 bundles into one file for a tunnel demo (read at build time from the shell).
VITE_TUNNEL=

# ── Scripts ─────────────────────────────────────────────────────────────
# backup.js: off-volume destination and snapshots kept (default 7).
RACKTRACK_BACKUP_DIR=
RACKTRACK_BACKUP_KEEP=
# reset-data.js: data folder to reset, and the name of the fresh organization.
RACKTRACK_DATA_DIR=
RESET_ORG_NAME=
# adopt-orphan-racks.js: scan outputs folder (default <repo>/outputs).
RACKTRACK_OUTPUTS=

# ── Tests only ──────────────────────────────────────────────────────────
# Load another settings file instead of this one (npm test points it nowhere).
RT_ENV_FILE=
# Replace the scan worker pool with a module, or with a stub that throws.
RACKTRACK_POOL_MODULE=
RACKTRACK_SKIP_WORKER_POOL=
